# ==============================
# General Settings
# ==============================
FS = 4000                # Sampling rate [Hz]
DURATION = 2.0           # Duration [s]
N = int(FS * DURATION)   # Number of samples = 8000
T = np.arange(N) / FS    # Time vector
FMAX = FS / 2.0          # Nyquist = 2000 Hz

# SNR levels according to the paper
SNR_LIST = [-5, 1, 2, 1, 1, 5, 10, 15, 20, 25, 30, 35]

# ==============================
# Mathematical Tools
# ==============================
def awgn(x: np.ndarray, snr_db: float, rng: np.random.Generator) -> np.ndarray:
    """Adds Gaussian noise so that the SNR (according to average power) is snr_db."""
    p_sig = np.mean(np.abs(x) ** 2)
    snr_lin = 10 ** (snr_db / 10.0)
    p_noise = p_sig / snr_lin
    noise = rng.normal(0.0, np.sqrt(p_noise), size=x.shape)
    return x + noise

def hanning(M: int) -> np.ndarray:
    """Continuous-discrete Hanning window of length M."""
    n = np.arange(M)
    return 0.5 - 0.5 * np.cos(2.0 * np.pi * n / (M - 1))

def stft_mag_128x8000(x: np.ndarray,
                     nfft: int = 4000,
                     win_len: int = 100,
                     hop: int = 1) -> np.ndarray:
    """
    STFT magnitude with Hanning window of length 57, step=1, centering (padding),
    FFT=4000 → Returns spectrogram of dimensions [2000, 8000] normalized to [0,1].
    """
    assert len(x) == N, "Signal length must be N=8000"
    w = hanning(win_len)
    pad = win_len // 2
    x_pad = np.pad(x, (pad, pad), mode='reflect')

    frames = []
    for t in range(0, N, hop):
        seg = x_pad[t: t + win_len]
        if len(seg) < win_len:
            seg = np.pad(seg, (0, win_len - len(seg)))
        X = np.fft.rfft(seg * w, n=nfft)  # Positive frequencies including Nyquist -> 2001
        frames.append(np.abs(X))

    S = np.stack(frames, axis=1)  # [2001, 8000]
    S = S[:-1, :]                  # Removing Nyquist → [2000, 8000]
    # Stable [0,1] normalization
    S = S / (np.max(S) + 1e-12)
    return S.astype(np.float32)

# ==============================
# Signal Models + IF
# ==============================
@dataclass
class PolyPhaseParams:
    a: float; b: float; c: float; d: float; e: float; h: float

def sample_param(rng: np.random.Generator, low=0.0, high=10.0) -> float:
    return rng.uniform(low, high)

def gen_poly_params(rng: np.random.Generator) -> PolyPhaseParams:
    return PolyPhaseParams(
        a=sample_param(rng, low=-5.0, high=5.0), 
        b=sample_param(rng, low=0.0, high=10.0), 
        c=sample_param(rng, low=-2.0, high=2.0), 
        d=sample_param(rng, low=-1.0, high=1.0), 
        e=sample_param(rng, low=-0.5, high=0.5), 
        h=sample_param(rng, low=-0.2, high=0.2)
    )

kl = 100
def poly_signal_and_if(t: np.ndarray, p: PolyPhaseParams) -> Tuple[np.ndarray, np.ndarray]:
    """
    x(t) = 100*cos(2π [a + bt + ct^2 + dt^3 + et^4 + ht^5])
    IF(t) = b + 2ct + 3dt^2 + 4et^3 + 5ht^4
    """
    phase = 2 * np.pi * (p.a + p.b*t + p.c*t**2 + p.d*t**3 + p.e*t**4 + p.h*t**5)
    x = 5000*np.cos(kl*phase)
    IF = (p.b + 2*p.c*t + 3*p.d*t**2 + 4*p.e*t**3 + 5*p.h*t**4)*kl
    return x, IF

@dataclass
class CosChirpParams:
    a: float; b: float; c: float  # π is used within the formula itself

def gen_coschirp_params(rng: np.random.Generator) -> CosChirpParams:
    return CosChirpParams(
        a=sample_param(rng, low=0.0, high=1.0), 
        b=sample_param(rng, low=0.0, high=1.0), 
        c=sample_param(rng, low=0.0, high=10.0)
    )

def coschirp_signal_and_if(t: np.ndarray, q: CosChirpParams) -> Tuple[np.ndarray, np.ndarray]:
    """
    x3(t) = 100*sin(2π [ aπ cos(bπ t + π) + c t ])
    IF3(t) = c - a*b*π^2 * sin(bπ t + π)
    """
    Ks= 5
    phase_inner = q.a * np.pi * np.cos(q.b * np.pi * t + np.pi) + q.c * t
    x = 1000 * np.sin(Ks*2*np.pi * phase_inner)
    IF = Ks*(q.c - (q.a * q.b * (np.pi**2)) * np.sin(q.b * np.pi * t + np.pi))
    return x, IF

def step_sine_signal_and_if(t: np.ndarray, freq_steps: List[float], step_times: List[float]) -> Tuple[np.ndarray, np.ndarray]:
    """
    Generate a sine wave with smooth stepwise frequency changes using linear chirps.
    freq_steps: List of frequencies for each step.
    step_times: List of times at which to switch frequencies.
    """
    x = np.zeros_like(t)
    IF = np.zeros_like(t)
    start = 0
    
    for i in range(len(step_times)):
        end = np.searchsorted(t, step_times[i])
        freq_start = freq_steps[i]
        freq_end = freq_steps[i + 1]
        
        # Calculate the instantaneous frequency for the chirp segment
        IF[start:end] = np.linspace(freq_start, freq_end, end - start)
        
        # Calculate the phase using a linear chirp
        t_segment = t[start:end]
        phase = 2 * np.pi * (freq_start * t_segment + 0.5 * (freq_end - freq_start) * t_segment**2 / (t_segment[-1] - t_segment[0]))
        x[start:end] = 5000 * np.sin(phase)
        
        start = end
    
    # Add the last segment if there's any remaining time
    if start < len(t):
        freq = freq_steps[-1]
        t_segment = t[start:]
        phase = 2 * np.pi * freq * t_segment
        x[start:] = 5000 * np.sin(phase)
        IF[start:] = freq
    
    return x, IF

# ==============================
# IF Range Control
# ==============================

def params_valid(IFs: List[np.ndarray], fmin: float = 0.0, fmax: float = FMAX) -> bool:
    for IF in IFs:
        if np.any((IF < fmin) | (IF > fmax) | ~np.isfinite(IF)):
            return False
    return True

def draw_valid_params_for_components(
    rng: np.random.Generator, n_components: int, max_tries: int = 200
):
    """
    Sample parameters until the IF of each component remains within [0, FMAX].
    """
    for _ in range(max_tries):
        xs, IFs = [], []
        if n_components >= 1:
            p1 = gen_poly_params(rng); x1, IF1 = poly_signal_and_if(T, p1)
            xs.append(x1); IFs.append(IF1)
        if n_components >= 2:
            p2 = gen_poly_params(rng); x2, IF2 = poly_signal_and_if(T, p2)
            xs.append(x2); IFs.append(IF2)
        if n_components == 3:
            q = gen_coschirp_params(rng); x3, IF3 = coschirp_signal_and_if(T, q)
            xs.append(x3); IFs.append(IF3)
        if n_components == 4:
            # Step sine wave
            freq_steps = [rng.uniform(1.0, 1000.0) for _ in range(4)]  # Random frequencies for each step
            step_times = [rng.uniform(0.25, 1.75) for _ in range(3)]  # Random times for each step
            step_times.sort()
            x4, IF4 = step_sine_signal_and_if(T, freq_steps, step_times)
            xs.append(x4); IFs.append(IF4)
        
        if params_valid(IFs):
            return xs, IFs
        else:
            # Print the IFs for debugging
            print(f"Attempt {_+1} failed. IFs: {[f'[{IF.min():.2f}, {IF.max():.2f}]' for IF in IFs]}")
    
    raise RuntimeError("Could not find valid parameters within a reasonable number of attempts.")

# ==============================
# Ideal TF Representation (Labels)
# ==============================

def ifs_to_ideal_tf(ifs_hz: List[np.ndarray],
                    n_freq_bins: int = 2000,
                    n_time_bins: int = 8000,
                    fmax: float = FMAX,
                    sigma_bins: float = 1.0) -> np.ndarray:
    """
    Maps IF vectors (in Hz) to an "ideal" TF mask:
    At each time t – marks 1 near the corresponding IF frequency; slight Gaussian blur on the frequency axis.
    """
    tf = np.zeros((n_freq_bins, n_time_bins), dtype=np.float32)
    for IF in ifs_hz:
        # Frequency index (0..n_freq_bins-1) per frame
        k = np.clip(np.round((IF / fmax) * (n_freq_bins - 1)).astype(int), 0, n_freq_bins - 1)
        tf[k, np.arange(n_time_bins)] = 1.0

    tf = gaussian_filter1d(tf, sigma=sigma_bins, axis=0, mode='nearest')

    m = tf.max() if tf.max() > 0 else 1.0
    return (tf / m).astype(np.float32)

# ==============================
# Binary Mask Generation
# ==============================

def generate_binary_mask(ideal_tf: np.ndarray, threshold: float = 0.5) -> np.ndarray:
    """
    Generate a binary mask from the ideal TF representation.
    Values above the threshold are set to 1 (white), and values below are set to 0 (black).
    """
    return (ideal_tf > threshold).astype(np.uint8)

# ==============================
# Sample Generator
# ==============================

@dataclass
class Sample:
    n_components: int
    x_clean: np.ndarray
    x_noisy: np.ndarray
    stft: np.ndarray          # [2000,8000]
    ifs_hz: List[np.ndarray]  # List of IFs at Hz (per component)
    ifs_norm: np.ndarray      # Matrix [P, 8000] normalized to [0,1] relative to FMAX
    tf_ideal: np.ndarray      # [2000,8000]
    binary_mask: np.ndarray   # Binary mask [2000,8000]

def generate_sample(rng: np.random.Generator,
                    n_components: int,
                    snr_db: float,
                    tf_sigma: float = 1.0) -> Sample:
    xs, IFs = draw_valid_params_for_components(rng, n_components=n_components)
    x_clean = np.sum(np.stack(xs, axis=0), axis=0)
    x_noisy = awgn(x_clean, snr_db=snr_db, rng=rng)
    S = stft_mag_128x8000(x_noisy, nfft=4000, win_len=57, hop=1)
    tf_ideal = ifs_to_ideal_tf(IFs, n_freq_bins=2000, n_time_bins=8000, fmax=FMAX, sigma_bins=tf_sigma)
    ifs_norm = (np.stack(IFs, axis=0) / FMAX).astype(np.float32)
    binary_mask = generate_binary_mask(tf_ideal)
    return Sample(n_components, x_clean.astype(np.float32), x_noisy.astype(np.float32),
                  S, IFs, ifs_norm, tf_ideal, binary_mask)

# ==============================
# Generate and Save 10,000 Samples
# ==============================

def save_image(image: np.ndarray, filename: str, cmap='viridis'):
    plt.figure(figsize=(10, 8))
    plt.imshow(image, aspect='auto', cmap=cmap, origin='lower', extent=[0, DURATION, 0, FMAX])
    plt.colorbar(label='Magnitude')
    plt.xlabel('Time [s]')
    plt.ylabel('Frequency [Hz]')
    plt.title('STFT Magnitude')
    plt.savefig(filename, format='jpg')
    plt.close()

def generate_and_save_samples(n_samples: int = 10000, output_dir: str = './data'):
    rng = np.random.default_rng(42)  # Seed for reproducibility

    # Create separate directories for STFT and masks
    stft_dir = os.path.join(output_dir, 'stft')
    mask_dir = os.path.join(output_dir, 'mask')
    os.makedirs(stft_dir, exist_ok=True)
    os.makedirs(mask_dir, exist_ok=True)

    for i in range(n_samples):
        n_components = rng.choice([1, 2, 3])  # Randomly choose 1, 2, or 3 components
        snr_db = rng.choice(SNR_LIST)          # Randomly choose SNR from the list
        tf_sigma = rng.uniform(0.5, 2.0)       # Randomly choose tf_sigma between 0.5 and 2.0
        sample = generate_sample(rng, n_components=n_components, snr_db=snr_db, tf_sigma=tf_sigma)
        
        # Save STFT image in stft directory
        stft_filename = os.path.join(stft_dir, f'stft_{i}.jpg')
        save_image(sample.stft, stft_filename)

        # Save binary mask image in mask directory with matching name
        mask_filename = os.path.join(mask_dir, f'stft_{i}.jpg')
        save_image(sample.binary_mask, mask_filename, cmap='gray')
        
        # Print progress
        if (i + 1) % 1000 == 0:
            print(f"Generated and saved {i + 1} samples.")

    print(f"STFT images saved to {stft_dir}")
    print(f"Mask images saved to {mask_dir}")

# ==============================
# Display Pairs Function
# ==============================

def generate_and_display_pairs(n_pairs: int = 5):
    """
    Generate n_pairs of STFT and mask samples and display them side by side.
    """
    rng = np.random.default_rng(42)  # Seed for reproducibility
    
    # Generate samples
    samples = []
    for i in range(n_pairs):
        n_components = rng.choice([1, 2, 3])  # Randomly choose 1, 2, or 3 components
        snr_db = rng.choice(SNR_LIST)          # Randomly choose SNR from the list
        tf_sigma = rng.uniform(0.5, 2.0)       # Randomly choose tf_sigma between 0.5 and 2.0
        sample = generate_sample(rng, n_components=n_components, snr_db=snr_db, tf_sigma=tf_sigma)
        samples.append(sample)
    
    # Create figure with subplots: n_pairs rows, 2 columns
    fig, axes = plt.subplots(n_pairs, 2, figsize=(16, 4 * n_pairs))
    
    # If only one pair, make axes 2D
    if n_pairs == 1:
        axes = axes.reshape(1, -1)
    
    for i, sample in enumerate(samples):
        # Left column: STFT spectrogram
        ax_stft = axes[i, 0]
        im1 = ax_stft.imshow(sample.stft, aspect='auto', cmap='viridis', origin='lower', 
                            extent=[0, DURATION, 0, FMAX])
        ax_stft.set_xlabel('Time [s]')
        ax_stft.set_ylabel('Frequency [Hz]')
        ax_stft.set_title(f'STFT Spectrogram {i+1} (Components: {sample.n_components})')
        plt.colorbar(im1, ax=ax_stft, label='Magnitude')
        
        # Right column: Binary mask
        ax_mask = axes[i, 1]
        im2 = ax_mask.imshow(sample.binary_mask, aspect='auto', cmap='gray', origin='lower',
                            extent=[0, DURATION, 0, FMAX])
        ax_mask.set_xlabel('Time [s]')
        ax_mask.set_ylabel('Frequency [Hz]')
        ax_mask.set_title(f'Binary Mask {i+1}')
        plt.colorbar(im2, ax=ax_mask, label='Mask Value')
    
    plt.tight_layout()
    plt.show()
    
    return samples

